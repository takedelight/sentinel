{
  "name": "@sentinel/api",
  "version": "1.0.50",
  "module": "src/main.ts",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "dev": "bun run --watch --env-file=../../.env src/main.ts",
    "start": "bun run --env-file=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint-staged": "lint-staged",
    "db:generate": "bun run --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun run --env-file=../../.env drizzle-kit migrate",
    "db:studio": "bun run --env-file=../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@sentinel/auth": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "latest",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sentinel/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt"
    ]
  }
}
