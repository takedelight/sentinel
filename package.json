{
  "name": "sentinel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "fullcheck": "turbo run lint format:check typecheck test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "^8.71.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-tailwindcss": "4",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
